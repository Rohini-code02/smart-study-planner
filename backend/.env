# Why this file exists:
# This file stores secret configuration variables. NEVER upload this file to 
# GitHub! It keeps your database passwords and API keys totally secure.

# The port our Express server will run on (Usually 5000 for backend)
PORT=5000

# The connection string to our MongoDB database. 
# You can replace this with your MongoDB Atlas URL when you are ready to deploy.
MONGO_URI=mongodb+srv://rohinigajula02:Rohini2026@cluster0.dqgszdl.mongodb.net/smartstudyplanner?retryWrites=true&w=majority&appName=Cluster0

